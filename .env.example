# Optional local overrides: copy to .env and uncomment only the values you need.
# Process environment > .env > configs/app.yaml. No credentials belong in this file.
# Values are literal; use a complete path instead of ${VARIABLE} interpolation.

# TTAL_MODE=manual
# TTAL_DEV_OWNER_ID=demo-user
# TTAL_RUNTIME_DIR=artifacts/runtime
# TTAL_BUSINESS_DATA_DIR=data/business/v1
# TTAL_CONFIG_VERSION=app-v1

# On a Linux server, keep runtime data outside the extracted source release:
# TTAL_RUNTIME_DIR=/srv/tool-agent-lab/state
