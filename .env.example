# Optional local overrides: copy to .env and uncomment only the values you need.
# Process environment > .env > configs/app.yaml. No credentials belong in this file.
# Values are literal; use a complete path instead of ${VARIABLE} interpolation.

# TTAL_MODE=manual
# TTAL_DEV_OWNER_ID=demo-user
# TTAL_RUNTIME_DIR=artifacts/runtime
# TTAL_BUSINESS_DATA_DIR=data/business/v1
# TTAL_CONFIG_VERSION=app-v1

# Local inference overrides, used with configs/models/qwen3b-local.yaml.
# TTAL_MODEL_BASE_PATH=models/base/Qwen2.5-3B-Instruct
# TTAL_MODEL_ADAPTER_PATH=models/adapters/candidate
# TTAL_MODEL_DEVICE=cuda:0
# TTAL_MODEL_PRECISION=4bit
# TTAL_MODEL_CONTEXT_TOKENS=4096

# Optional HTTP compatibility overrides.
# TTAL_MODEL_BASE_URL=http://your-model-server:8001/v1
# TTAL_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
# TTAL_MODEL_VERSION=qwen2.5-3b-base-v1
# TTAL_MODEL_MAX_TOKENS=512
# TTAL_MODEL_API_KEY=

# On a Linux server, keep runtime data outside the extracted source release:
# TTAL_RUNTIME_DIR=/srv/tool-agent-lab/state
